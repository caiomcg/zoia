# Public entry point for zoia. Certificates come from Let's Encrypt over a
# Cloudflare DNS-01 challenge, so no inbound port 80 is required.
#
# This proxy deliberately serves these two hostnames and nothing else: any
# other Host header gets a connection refused rather than reaching a service.
# The one exception is a site the operator drops into caddy/sites/ on the
# server, such as a homolog environment (docs/adr/0035-homolog-environment.md).

# No global options block. An `email` directive here would be ideal for Let's
# Encrypt expiry notices, but the Caddyfile has no way to omit a directive when
# its variable is empty — `email {$ACME_EMAIL}` with nothing set is a parse
# error and crash-loops the container. If you want expiry mail, hardcode it:
#   { email you@example.com }

# What every site serving the web app shares. Defined before the import below
# so the server-local sites can use it too.
(zoia_app) {
	tls {
		dns cloudflare {$CLOUDFLARE_API_TOKEN}
	}

	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "same-origin"
		-Server
	}
}

# The web app.
{$ZOIA_HOSTNAME} {
	import zoia_app
	reverse_proxy app:3000
}

# LiveKit signalling. This host is essentially one long-lived WebSocket;
# Caddy streams it without the read timeout that would cut it mid-broadcast.
{$SFU_HOSTNAME} {
	tls {
		dns cloudflare {$CLOUDFLARE_API_TOKEN}
	}

	# livekit runs in the host network namespace, so it is reached via the
	# docker bridge gateway rather than a service name.
	#
	# This one route also carries hardware-encoded broadcasts: the SFU serves
	# WHIP itself at /whip/v1, and its media uses the same UDP 7882 as
	# everything else. See docs/adr/0011-hardware-encoding-over-the-internet.md.
	reverse_proxy host.docker.internal:7880
}

# Sites that exist on this server only, never in git: caddy/sites/ is
# gitignored and deploy.sh never transfers it. A glob that matches nothing is
# not an error, so a server without any serves exactly the two hosts above.
# See caddy/homolog.caddy.example.
import /etc/caddy/sites/*.caddy
