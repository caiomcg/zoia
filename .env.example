# ---- public URLs -------------------------------------------------------------
# The hostname viewers open. Must match the Caddyfile and the DNS record.
PUBLIC_HOST=zoia.example.com
# The LiveKit signalling URL the browser connects to.
SFU_HOST=sfu.example.com
LIVEKIT_WS_URL=wss://sfu.example.com

# ---- tls (caddy) -------------------------------------------------------------
# Cloudflare API token, scoped to Zone:DNS:Edit on this zone only.
# Used for the ACME DNS-01 challenge; no inbound port 80 is required.
CLOUDFLARE_API_TOKEN=replace-me
# Optional: Let's Encrypt expiry notices.
ACME_EMAIL=

# ---- livekit credentials -----------------------------------------------------
# Generate with: docker run --rm livekit/generate
# LIVEKIT_KEYS is consumed by the livekit container; the two below by the app.
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=replace-me-with-32-plus-random-chars
LIVEKIT_KEYS=devkey: replace-me-with-32-plus-random-chars

# ---- app ---------------------------------------------------------------------
# Signs session cookies. Generate with: openssl rand -base64 48
SESSION_SECRET=replace-me
ROOM_NAME=zoia
PORT=3000
# Trust one proxy hop (caddy) so rate limiting sees real client IPs.
TRUST_PROXY=1
