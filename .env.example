# ---- public URLs -------------------------------------------------------------
# The hostname viewers open. Must match the Caddyfile and the DNS record.
PUBLIC_HOST=zoia.example.com
# The LiveKit signalling URL the browser connects to.
SFU_HOST=sfu.example.com
LIVEKIT_WS_URL=wss://sfu.example.com

# ---- tls (caddy) -------------------------------------------------------------
# Cloudflare API token, scoped to Zone:DNS:Edit on this zone only.
# Used for the ACME DNS-01 challenge; no inbound port 80 is required.
CLOUDFLARE_API_TOKEN=replace-me
# Optional: Let's Encrypt expiry notices.

# ---- livekit credentials -----------------------------------------------------
# Generate with: docker run --rm livekit/generate
# LIVEKIT_KEYS is consumed by the livekit container; the two below by the app.
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=replace-me-with-32-plus-random-chars
LIVEKIT_KEYS=devkey: replace-me-with-32-plus-random-chars

# ---- app ---------------------------------------------------------------------
# Signs session cookies. Generate with: openssl rand -base64 48
SESSION_SECRET=replace-me
ROOM_NAME=zoia
# ROOM_NAME is the default channel's LiveKit room: where older clients land.
# Admins can add, rename and remove (empty) channels. MAX_CHANNELS is how many
# there may be to start, default included; admins raise or lower it in the app
# (up to 20) and that choice is kept in the database. Channels are kept in
# server/data/channels.json.
# DEFAULT_CHANNEL_NAME=Geral
# MAX_CHANNELS=10

# Accounts (ADR 0031). How many machines one person may have signed in at
# once (one more replaces the least recently used), how many days a machine
# may sit unused before it is signed out, and how many sign-ups may wait for
# an admin before sign-up closes until someone works the queue.
# Every credential and identity, in one SQLite file (ADR 0032). The JSON
# files from before it are imported once on first start and kept as
# *.imported. Back it up with: npm run keytool -- db:backup <path>
# DATABASE_FILE=server/data/zoia.db
# ACCOUNT_DEVICE_CAP=5
# ACCOUNT_DEVICE_IDLE_DAYS=60
# ACCOUNT_MAX_PENDING=20
# Minutes someone may sit in a channel neither sharing nor watching anyone
# before the server kicks them (ADR 0037). 0 turns it off.
# IDLE_KICK_MINUTES=10
# Text chats (ADR 0036). The chat list and how many there may be live in the
# database above; admins raise or lower the limit, which starts at ten.
# Messages live in ScyllaDB. docker-compose.yml points the app at its scylla
# container; set SCYLLA_CONTACT_POINTS yourself only when running the app
# outside compose. Without it, chat is off.
# DEFAULT_CHAT_NAME=Geral
# Photos and videos sent in chats, up to 10 MB each, are files on this disk.
# CHAT_MEDIA_DIR=server/data/chat-media
# SCYLLA_CONTACT_POINTS=127.0.0.1
# SCYLLA_LOCAL_DC=datacenter1
# SCYLLA_KEYSPACE=zoia
PORT=3000
# Trust one proxy hop (caddy) so rate limiting sees real client IPs.
TRUST_PROXY=1

# ---- broadcast quality -------------------------------------------------------
# The server sends one copy of the stream per remote viewer, so the uplink needs
# MAX_BITRATE x viewers. 20 Mbit with three remote viewers is 60 Mbit up.
# Lower MAX_BITRATE until it fits your actual upload.
MAX_BITRATE=20000000
MAX_FRAMERATE=60
CAPTURE_WIDTH=3840
CAPTURE_HEIGHT=2160
# vp9 compresses screen content best; h264 is more likely to be hardware
# encoded, which matters if the broadcaster's CPU struggles at 4K60.
VIDEO_CODEC=vp9

# Hardware-encoded broadcasts need no setting of their own. They publish over
# WHIP to the SFU at LIVEKIT_WS_URL's host (wss://sfu.example.com becomes
# https://sfu.example.com/whip/v1), using the same ports as everything else.
# See docs/adr/0011-hardware-encoding-over-the-internet.md.
