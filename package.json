{
  "name": "zoia",
  "version": "0.1.0",
  "private": true,
  "description": "Private one-to-many screen broadcast over a self-hosted LiveKit SFU.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server/src/index.js",
    "dev": "node --watch server/src/index.js",
    "test": "node --test server/test/*.test.js",
    "test:coverage": "node --test --experimental-test-coverage server/test/*.test.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "keytool": "node server/bin/keytool.js",
    "prepare": "husky",
    "coverage:check": "node scripts/coverage-check.js",
    "version:check": "node scripts/check-release-version.js"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "livekit-server-sdk": "^2.13.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "prettier": "^3.6.2",
    "supertest": "^7.1.4"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/caiomcg/zoia.git"
  },
  "homepage": "https://github.com/caiomcg/zoia",
  "bugs": {
    "url": "https://github.com/caiomcg/zoia/issues"
  }
}
